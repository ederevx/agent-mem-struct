{
  "schema": 1,
  "settings": "{user_home}/.agent-mem-struct/judge.json",
  "adapter": "rm_judge_adapter.py",
  "capture_bytes": 8388608,
  "review_teardown_s": 30,
  "lock_timeout_s": 2,
  "lock_poll_s": 0.05,
  "defaults": {
    "protocol": 2,
    "baseline_entries": 64,
    "timeout_s": 30,
    "max_turns": 32,
    "max_input_bytes": 65536,
    "max_output_bytes": 4096
  },
  "hosts": {
    "pi": {
      "command": [
        "pi",
        "-p",
        "--no-session",
        "--no-tools",
        "--no-mcp",
        "--no-extensions",
        "--no-skills",
        "--no-prompt-templates",
        "--no-context-files"
      ],
      "prompt": "argv",
      "answer": "stdout",
      "extra_env": [],
      "extensions": [],
      "extension_flag": "-e"
    },
    "claude": {
      "command": [
        "claude",
        "-p",
        "--output-format",
        "text",
        "--safe-mode",
        "--tools",
        "",
        "--no-session-persistence",
        "--permission-mode",
        "dontAsk",
        "--permission-prompts",
        "none"
      ],
      "prompt": "stdin",
      "answer": "stdout",
      "extra_env": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_OAUTH_TOKEN"
      ]
    },
    "codex": {
      "command": [
        "codex",
        "exec",
        "-",
        "--ephemeral",
        "-s",
        "read-only",
        "--color",
        "never",
        "--skip-git-repo-check",
        "--disable",
        "hooks",
        "--disable",
        "plugins",
        "--disable",
        "apps"
      ],
      "prompt": "stdin",
      "answer": "file",
      "extra_env": [
        "OPENAI_API_KEY",
        "CODEX_HOME"
      ]
    }
  }
}
